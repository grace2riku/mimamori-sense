--- a/e2studio_CPU0/src/usermain.c
+++ b/e2studio_CPU0/src/usermain.c
@@ -60,6 +60,42 @@
  * ISR からは呼べない audio_stop() をタスクコンテキストで代行する。 */
 #include "audio_alarm.h"
 
+/* ---------------------------------------------------------------------------
+ * 白画面切り分け用の一時スイッチ（doc/design/white-screen-boot-regression.md 4.3）
+ *
+ * 1 = タスクを生成・起動する（本来の動作） / 0 = 生成しない
+ *
+ * 目的: `main` の起動時消費電流を下げたときに白画面が消えるかを見て、
+ *       退行が「負荷要因」か「ソフト要因」かを分ける（Phase 1 / 実験 B-2）。
+ *
+ * 落としてよい根拠（grep で確認済み）:
+ *   - audio: audio_init() の呼び出し元は audio_port.c:775（audio_task）と
+ *     :931（NT-Shell の手動実行）だけ。audio_task を生成しなければ
+ *     起動時に DA7212 は初期化されない。
+ *   - alarm: audio_start() / audio_stop() の呼び出し元は audio_alarm.c:799 / :647
+ *     （どちらも alarm_task の reconcile 経路。集約点は :1471-1472）、
+ *     audio_port.c:940 / :957（NT-Shell の手動）、:641（audio_start 内部の
+ *     ロールバック）だけ。起動時に音を出す経路は alarm_task のみ。
+ *     ★ AUDIO を 0 にするなら ALARM も必ず 0 にする。
+ *   - ai: g_ai_app_flgid は ai_inference_task が生成するまで 0 のままで、
+ *     camera_display.c:401 のガードにより AI 連携ブロックが丸ごとスキップされる。
+ *     表示パイプラインは動く。
+ *
+ * 注意:
+ *   - 0 にしたタスクの ctsk_xxx が未使用になり -Wunused-variable が出る。
+ *     .cproject に -Werror は無いのでビルドは通る。
+ *   - camera / lvgl は表示そのものなので落とさない。
+ *   - この実験でも消えないもの: RTC サブクロック発振（#215、BSP 初期化）、
+ *     pin_data.c のピン設定、LTO（#196）、Dave2D プール化（#197）、
+ *     lv_conf_user.h（#190）、FreeRTOS 撤去（#198）。
+ *
+ * ★ 調査が終わったら 3 つすべて 1 に戻すこと。
+ *   git checkout -- e2studio_CPU0/src/usermain.c でも戻せる。
+ * ------------------------------------------------------------------------- */
+#define WSB_ENABLE_AI_TASK      1   /* AI 推論（NPU / 224px） */
+#define WSB_ENABLE_AUDIO_TASK   1   /* DA7212 + SSIE0/DTC/GPT の初期化 */
+#define WSB_ENABLE_ALARM_TASK   1   /* 警報音（AUDIO=0 ならこちらも 0） */
+
 /*
  * ボード LED 定義（FSP 提供）。
  * FreeRTOS 版 blinky_thread_entry.c と同じく g_bsp_leds を使用する。
@@ -548,6 +584,7 @@ EXPORT INT usermain(void)
      * （LVGL タイマ）側は ID が 0 の間は AI 連携ブロックをスキップする。
      * ログは他タスクと同じく T-Monitor（SCI8 一本化 ― R-005 の注意参照）。
      * --------------------------------------------------------------------- */
+#if WSB_ENABLE_AI_TASK      /* 白画面切り分け用スイッチ（ファイル先頭） */
     tskid = tk_cre_tsk(&ctsk_ai_inference);
     if (tskid <= E_OK) {
         tm_printf((UB *)"[usermain] tk_cre_tsk(ai_inference) failed. ercd = %d\n", (INT)tskid);
@@ -561,6 +598,7 @@ EXPORT INT usermain(void)
     }
 
     tm_putstring((UB *)"[usermain] ai_inference_task created & started.\n");
+#endif /* WSB_ENABLE_AI_TASK */
 
     /* ---------------------------------------------------------------------
      * オーディオ出力タスクを生成・起動（Issue #46 / S-005-2）
@@ -570,6 +608,7 @@ EXPORT INT usermain(void)
      * 待ってから IIC1 を開くため、camera / lvgl との起動順に制約は無い。
      * ログは他タスクと同じく T-Monitor（SCI8 一本化 ― R-005 の注意参照）。
      * --------------------------------------------------------------------- */
+#if WSB_ENABLE_AUDIO_TASK   /* 白画面切り分け用スイッチ（ファイル先頭） */
     tskid = tk_cre_tsk(&ctsk_audio);
     if (tskid <= E_OK) {
         tm_printf((UB *)"[usermain] tk_cre_tsk(audio) failed. ercd = %d\n", (INT)tskid);
@@ -583,6 +622,7 @@ EXPORT INT usermain(void)
     }
 
     tm_putstring((UB *)"[usermain] audio_task created & started.\n");
+#endif /* WSB_ENABLE_AUDIO_TASK */
 
     /* ---------------------------------------------------------------------
      * 警報音タスクを生成・起動（Issue #47 / S-005-3）
@@ -594,6 +634,7 @@ EXPORT INT usermain(void)
      * audio_start() 経由でデバイス状態を検査し、未初期化なら
      * FSP_ERR_NOT_OPEN を返す（src/port/audio_port.c:562-575）。
      * --------------------------------------------------------------------- */
+#if WSB_ENABLE_ALARM_TASK   /* 白画面切り分け用スイッチ（ファイル先頭） */
     tskid = tk_cre_tsk(&ctsk_alarm);
     if (tskid <= E_OK) {
         tm_printf((UB *)"[usermain] tk_cre_tsk(alarm) failed. ercd = %d\n", (INT)tskid);
@@ -607,6 +648,7 @@ EXPORT INT usermain(void)
     }
 
     tm_putstring((UB *)"[usermain] alarm_task created & started.\n");
+#endif /* WSB_ENABLE_ALARM_TASK */
 
     /* usermain() を終了させない（終了すると μT-Kernel がシャットダウンするため）。
