 /** Console output buffer size */
+/* ---------------------------------------------------------------------------
+ * 白画面切り分け用の一時スイッチ（doc/design/white-screen-boot-regression.md 4.6）
+ *
+ * 電源投入から DISP_RESET 解放までの時間を延ばす。0 = 遅延なし（本来の動作）。
+ *
+ * 目的: 表示の設定値・立ち上げコード・新規デバイスの負荷・パネルクロックはすべて
+ *       白画面の成立条件ではないと実測で潰れた（手順書 4.6.1）。残る差は
+ *       「同じコードがいつ走るか」だけなので、立ち上げを遅らせて白が消えるかを見る。
+ *
+ * 待ちに tk_dly_tsk() を使う理由: glcdc_port_init() の呼び出し元は lvgl_task だけ
+ *       （src/lvgl_thread_entry.c:168。他に呼び出し元は無い）なのでタスクコンテキストで
+ *       あることが保証される。同ファイルの glcdc_cmd_dbuf() も tk_dly_tsk() を使っている。
+ *       R_BSP_SoftwareDelay() はビジーループで他タスクを止めてしまい、
+ *       「立ち上げを遅らせる」以外の条件も変わるため使わない。
+ *
+ * ★ 調査が終わったら 0 に戻すこと（git checkout -- src/port/glcdc_port.c でも戻せる）。
+ * ------------------------------------------------------------------------- */
+#define WSB_DISPLAY_INIT_DELAY_MS   (500)
+
 #define GLCDC_PRINT_BUF_SIZE    (128)
 
 /**
@@ -1942,6 +1961,12 @@ bool glcdc_port_init(void)
      *
      * Reference: reference_projects/lv_port_renesas_ek_ra8p1/src/port/lv_port_disp.c:88-102
      */
+#if (WSB_DISPLAY_INIT_DELAY_MS > 0)
+    /* 白画面切り分け用の遅延（ファイル先頭の WSB_DISPLAY_INIT_DELAY_MS）。
+     * DISP_RESET を解放する前に待つ。調査用の一時コード。 */
+    tk_dly_tsk(WSB_DISPLAY_INIT_DELAY_MS);
+#endif
+
     glcdc_lcd_reset();
 
