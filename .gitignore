e2studio_CPU0/.settings/DebugVirtualConsoleSetting.xml
e2studio_CPU0/.settings/IORegisterSetting.xml
e2studio_CPU0/.settings/com.renesas.cdt.ddsc.settingseditor.prefs
e2studio_CPU0/.settings/com.renesas.cdt.ddsc.threads.configurator.prefs
e2studio_CPU1/.settings/CoverageSetting.xml
